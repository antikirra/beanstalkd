[Unit]
Description=Beanstalkd work queue
Documentation=https://github.com/beanstalkd/beanstalkd
After=network.target

[Service]
# The server reports READY=1 once the binlog is replayed and it is about
# to serve, so "started" means "answers" and units ordered After= this
# one do not race the replay. NotifyAccess=main: only the server's own
# pid is believed.
Type=notify
NotifyAccess=main
# Replay of a large binlog happens before READY; give it room.
TimeoutStartSec=10min
# The event loop sends WATCHDOG=1 every 15s. A loop that stops turning
# stops sending, and the service is killed (SIGABRT) and restarted.
WatchdogSec=30s

User=nobody
# /var/lib/beanstalkd, created and owned by User= on start. The only
# place on the filesystem the service may write (see ProtectSystem).
StateDirectory=beanstalkd
StateDirectoryMode=0700
# Example with WAL and structured logs:
#   ExecStart=/usr/bin/beanstalkd -b /var/lib/beanstalkd -F --log-json
ExecStart=/usr/bin/beanstalkd

# Graceful stop: SIGUSR1 enters drain mode (refuses new PUTs, lets
# reserved jobs finish), then systemd sends SIGTERM after the sleep
# window to break the event loop cleanly.
ExecStop=/bin/sh -c '/bin/kill -USR1 $MAINPID; sleep 25'
TimeoutStopSec=35s

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=beanstalkd

# Connection ceiling. Raise if you expect many concurrent clients.
LimitNOFILE=65536

# OOM backstop: tubes/jobs/reservations are unbounded inside the
# process, so without a cgroup limit a runaway producer can exhaust
# host memory. Tune for the working set, or comment out to disable.
MemoryMax=2G

# Sandbox. The server needs a TCP socket and its state directory, and
# nothing else: no privileges, no devices, no view of /home, a
# read-only rest of the filesystem, and only the syscalls an ordinary
# network service uses.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
