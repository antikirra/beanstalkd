FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc clang libc6-dev make cppcheck \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# Default flags first: the release build is what ships, and a warning
# that only appears without a sanitizer (they change what the optimiser
# can prove) must not reach a tag.
RUN make clean && make check

# Same suite through clang. A second front end catches what the first
# one's warning set does not, and it keeps the aarch64 CRC path honest:
# clang refuses the GCC spelling of the target attribute, so this build
# is what proves the portable spelling still compiles both ways.
RUN make clean && make check CC=clang

# Unit tests under UBSan (traps on first undefined behavior)
RUN make clean && make check \
    CFLAGS="-O2 -Wall -Werror -Wformat=2 -g -fsanitize=undefined -fno-sanitize-recover=all" \
    LDFLAGS="-fsanitize=undefined" \
    LDLIBS="-lrt -lpthread -lubsan"

# AddressSanitizer: use-after-free and out-of-bounds on the real test
# workload. allocator_may_return_null keeps the deliberate
# "zalloc(SIZE_MAX) must return 0" test from aborting the run; leak
# reporting is off because ct forks one process per test and never
# unwinds them.
RUN make clean && ASAN_OPTIONS=allocator_may_return_null=1:detect_leaks=0 \
    make check \
    CFLAGS="-O1 -g -fsanitize=address -fno-omit-frame-pointer -Wall -Wformat=2" \
    LDFLAGS="-fsanitize=address" \
    LDLIBS="-lrt -lpthread"

# ThreadSanitizer is NOT run here: it needs ADDR_NO_RANDOMIZE, which a
# build step cannot ask for, so it dies in `docker build` before running
# a single test. Run it against the same image by hand — the fsync
# thread shares the Wal with the main loop, so it is worth doing before
# a release:
#
#   docker run --rm --security-opt seccomp=unconfined \
#     -e TSAN_OPTIONS=allocator_may_return_null=1:report_thread_leaks=0 \
#     -v "$PWD":/src -w /src <image> sh -c 'make clean && make check \
#       CFLAGS="-O1 -g -fsanitize=thread -fno-omit-frame-pointer -Wall -Wformat=2" \
#       LDFLAGS="-fsanitize=thread" LDLIBS="-lrt -lpthread"'
#
# Run it SEVERAL TIMES, and put a `timeout` on each run. What TSan finds
# depends on how the scheduler happened to interleave, so one green pass
# proves very little: the problems it has caught in this tree showed up
# about once in two runs and once in ten, and neither was reported as a
# race — one hung the suite outright, the other looked like a server
# ignoring SIGTERM. Build once, then loop the binary:
#
#   for i in $(seq 8); do timeout 600 ./ct/_ctcheck || echo "run $i BAD"; done
#
# And read a TSan failure carefully before believing it is about your
# code. Signal DELIVERY is the sore spot: two tests flake here for what
# looks like the same reason, and neither is a product fault.
#
#   cttest_binlog_empty_exit — SIGTERM sent the instant the server comes
#   up; the process stays asleep in do_epoll_wait with nothing blocked,
#   nothing pending and a handler installed, which means the kernel
#   delivered the signal and the user handler did not run. The harness
#   works around most of it by connecting to the server while it waits,
#   which ends the epoll park and lets the deferred handler run: about
#   one failure in five without that, one in twenty-five with it, over
#   fifty runs. The failure message reports /proc state, wchan, the
#   signal masks, and whether the handler left its byte on the pipe.
#
#   cttest_put_drained_between_header_and_body_replies_draining —
#   SIGUSR1 between a put's header and its body; the same delay lets the
#   body land before drain mode is on, and the job is accepted.
#
# The honest measurement of SIGTERM latency lives in bench/shutdown,
# with no sanitizer in the way: 4ms while parked in epoll.

# cppcheck: zero false-positive static analysis
# (every hand-written production .c; vers.c is generated by the Makefile
# and intentionally excluded)
RUN cppcheck --error-exitcode=1 --enable=warning,performance \
    --suppress=missingIncludeSystem --quiet \
    --std=c11 -I. \
    conn.c crc32c.c file.c heap.c job.c linux.c main.c ms.c net.c \
    primes.c prot.c serv.c time.c tube.c util.c walg.c
